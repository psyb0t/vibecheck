# Vibecheck deployment configuration.
#
# Copy to .env and fill in real values for a local run. The real .env is
# gitignored; only this file with placeholder values is committed.
#
# Configuration is read once at startup and never reloaded. A changed value
# takes effect on the next restart. An invalid value fails the process before
# it serves a request, rather than surfacing on the first call that reads it.

# --- Servicepack framework ---------------------------------------------------
# Environment selected by goenv: prod or dev.
ENV=prod
# debug, info, warn, or error.
LOG_LEVEL=info
# json or text.
LOG_FORMAT=json
LOG_ADD_SOURCE=false
# Whole-application graceful shutdown deadline.
RUNNER_SHUTDOWNTIMEOUT=10s
# Comma-separated in-process service allowlist. Empty means every registered
# service.
SERVICES_ENABLED=

# --- Compose deployment ------------------------------------------------------
# Host directory holding your policy YAML. Compose mounts it read-only at
# /config/policies.
VIBECHECK_POLICY_HOST_DIR=./policies
# Host port the public listener is published on, bound to loopback.
VIBECHECK_HTTP_PUBLISH_PORT=8080

# --- Listeners and authentication --------------------------------------------
# Public REST and MCP listener. Binds loopback by default; put a reverse proxy
# in front of it before exposing anything.
VIBECHECK_HTTP_LISTEN_ADDRESS=127.0.0.1:8080
# Metrics listener, kept off the public surface.
VIBECHECK_METRICS_LISTEN_ADDRESS=127.0.0.1:9091
# Optional bearer token covering both REST and MCP. Empty permits
# trusted-loopback use only.
VIBECHECK_API_TOKEN=

# --- Policies and request limits ---------------------------------------------
# Directory of versioned policy YAML, mounted read-only.
VIBECHECK_POLICY_DIR=/config/policies
# Allow a complete policy in the request body. Off unless a deployment wants
# one-shot decisions.
VIBECHECK_ALLOW_INLINE_POLICIES=false
VIBECHECK_MAX_REQUEST_BYTES=1048576
VIBECHECK_MAX_STATE_BYTES=524288
VIBECHECK_MAX_FACTS=128
VIBECHECK_MAX_QUESTIONS=64
VIBECHECK_MAX_POLICY_BYTES=262144
VIBECHECK_MAX_METADATA_ENTRIES=16
VIBECHECK_MAX_METADATA_VALUE_LENGTH=256

# --- Rate limiting -----------------------------------------------------------
# One global token bucket shared by every caller, covering REST and MCP.
# Vibecheck sits behind a proxy or on loopback, so a per-address bucket would
# usually see only the proxy's address anyway.
VIBECHECK_RATE_LIMIT_PER_MINUTE=600
VIBECHECK_RATE_LIMIT_BURST=60

# --- TypeSafe Jev provider ---------------------------------------------------
VIBECHECK_TYPESAFE_BASE_URL=https://api.typesafe.ai
VIBECHECK_TYPESAFE_API_KEY=your-typesafe-api-key-here
VIBECHECK_TYPESAFE_MODEL=jev-latest
VIBECHECK_TYPESAFE_TIMEOUT=10s
VIBECHECK_TYPESAFE_MAX_RESPONSE_BYTES=1048576
VIBECHECK_TYPESAFE_CONCURRENCY=32
VIBECHECK_TYPESAFE_MAX_ATTEMPTS=3

# --- Database ----------------------------------------------------------------
# sqlite for one self-hosted process, postgres for shared or replicated
# deployments.
VIBECHECK_DB_DRIVER=sqlite
VIBECHECK_DB_SQLITE_PATH=/data/vibecheck.sqlite
VIBECHECK_DB_SQLITE_BUSY_TIMEOUT=5s
VIBECHECK_DB_HOSTNAME=localhost
VIBECHECK_DB_PORT=5432
VIBECHECK_DB_USERNAME=vibecheck
VIBECHECK_DB_PASSWORD=your-database-password-here
VIBECHECK_DB_NAME=vibecheck
VIBECHECK_DB_IS_SSL=true

# --- Retention ---------------------------------------------------------------
# Raw state and facts are not stored unless this is enabled, and enabling it
# without a valid 32-byte base64 data key is refused at startup.
VIBECHECK_STORE_INPUTS=false
VIBECHECK_DATA_KEY=
# How long a recorded evaluation is kept. 0 keeps evaluations indefinitely.
VIBECHECK_EVALUATION_RETENTION=720h
# How long an Idempotency-Key stays replayable.
VIBECHECK_IDEMPOTENCY_RETENTION=24h
# How often the cleanup loop sweeps expired rows. Must be positive.
VIBECHECK_RETENTION_CLEANUP_INTERVAL=1h
